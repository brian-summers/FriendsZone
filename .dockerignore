# Keep the build context small, and - more importantly - keep the *host's*
# node_modules out of it.
#
# Without this, `COPY . .` overwrites the `node_modules` that `npm ci` just
# built inside the image. On a Windows host those are NTFS junctions, which
# resolve to nothing on Linux, and every workspace import fails to resolve. The
# build then dies with "Cannot find module '@friendszone/contracts'", which
# looks like a TypeScript problem and is not.
node_modules
**/node_modules

# Build output. The image builds its own from source; copying a stale `dist`
# in risks shipping something that was never compiled from this tree.
dist
**/dist
*.tsbuildinfo
**/*.tsbuildinfo

# Local state and secrets - neither belongs in an image layer.
.data
.env
.env.*
!.env.example

.git
.github
.claude
.vscode

# Documentation does not change the image, and excluding it means a docs-only
# commit reuses every cached layer.
docs
*.md
!README.md
