# Copy to .env for local development. NEVER commit .env.
# Every variable here is parsed and validated at boot by apps/api/src/config.ts —
# the process refuses to start if any is missing or malformed. That is deliberate:
# a misconfigured security control must fail closed, not default to "off".

NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Postgres. Validated at boot but not yet connected to — the API currently runs
# on in-memory adapters. See docs/adr/0004-persistence.md.
DATABASE_URL=postgres://friendszone:friendszone@localhost:5432/friendszone

# Session/token signing. Generate with: openssl rand -base64 48
# Must be >= 32 bytes of entropy. The config validator enforces length.
SESSION_SECRET=replace-me-with-at-least-32-bytes-of-random-data

# Public origin used for cookie scoping, CORS allowlist, and link generation.
# In production this is the deployed origin: https://friends-zone.app
PUBLIC_ORIGIN=http://localhost:5173
