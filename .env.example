# Copy to .env for local development. NEVER commit .env.
# Every variable here is parsed and validated at boot by apps/api/src/config.ts -
# the process refuses to start if any is missing or malformed. That is deliberate:
# a misconfigured security control must fail closed, not default to "off".

NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Which store to use (ADR 0004, ADR 0026).
#
#   postgres://user:pass@host:5432/db   a real server
#   pglite://./.data/pg                 Postgres 18 in-process, persisted to a
#                                       directory - a real engine, nothing to
#                                       install. Good for local development.
#   memory://                           in-memory only; a boot failure in
#                                       production, because data would be lost
#
# The database holds password hashes, session hashes, and email addresses.
# Encryption at rest is the deployment's job.
DATABASE_URL=pglite://./.data/pg

# Session/token signing. Generate with: openssl rand -base64 48
# Must be >= 32 bytes of entropy. The config validator enforces length.
SESSION_SECRET=replace-me-with-at-least-32-bytes-of-random-data

# Public origin used for cookie scoping and link generation.
#
# The session cookie's `Secure` flag is tied to this being https, rather than to
# NODE_ENV: the question is whether this connection can carry a secure cookie,
# and the origin is the honest answer. In production this is the deployed
# origin: https://friends-zone.app
PUBLIC_ORIGIN=http://localhost:5173

# Comma-separated user ids allowed to open the moderation queue. Empty means
# nobody can - the correct fail-closed posture for an unconfigured deployment.
# A deploy-time value on purpose: a role in the database is a role a write
# endpoint can be tricked into granting. See docs/adr/0018-reporting-and-moderation.md.
# The demo seed's Dave: 44444444-4444-4444-8444-444444444444
MODERATOR_IDS=

# Where the content-free "a report was filed" pointer is sent.
REPORTS_EMAIL=reports@friends-zone.app

# Rate limiting. On by default; the API refuses to start in production with this
# set to false. Off only for test suites and local load work.
# See docs/adr/0020-rate-limiting.md.
RATE_LIMIT_ENABLED=true

# How many reverse proxies sit in front of this process (ADR 0027).
#
# `request.ip` feeds the anonymous rate-limit bucket. 0 trusts nothing, which
# over-limits rather than allowing a bypass; behind one CloudFront distribution
# this is 1. Never set it higher than the number of proxies you actually run -
# X-Forwarded-For is caller-supplied.
TRUSTED_PROXY_HOPS=0

