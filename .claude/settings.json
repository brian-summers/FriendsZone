{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run verify)",
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(npm run test:watch)",
      "Bash(npx tsc --build)",
      "Bash(npx tsc --build --force)",
      "Bash(npx vitest run)",
      "Bash(npm install)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  }
}
